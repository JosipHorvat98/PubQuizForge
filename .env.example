# file: .env.example
# Copy this file to `.env.local` and fill in your real values.
#
# IMPORTANT:
#   - `.env.local` is git-ignored (contains secrets) and is NEVER committed/pushed.
#   - This `.env.example` is the template that IS in the repo.
#   - On a new machine (e.g. at home) run:  `git pull`  then copy:
#        Copy-Item .env.example .env.local
#     and fill in the values.

# --- Site ---
# Local development URL. In production this is set separately (Vercel).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Stripe (https://dashboard.stripe.com/test/apikeys) ---
# Server-side secret key.
STRIPE_SECRET_KEY=sk_test_...
# Webhook signing secret (Stripe Dashboard -> Webhooks -> your endpoint).
STRIPE_WEBHOOK_SECRET=whsec_...

# --- Supabase (project Dashboard -> Settings -> API / Connect) ---
# Project URL (e.g. https://abcd1234.supabase.co).
NEXT_PUBLIC_SUPABASE_URL=https://TUJPROJEKT.supabase.co
# "Publishable" / anon key (public, safe to ship to the browser).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJ...
# service_role secret — SERVER ONLY. Never expose or commit it.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
# Used only by scripts/upload-packs.mjs (copy of the project URL above).
SUPABASE_URL=https://TUJPROJEKT.supabase.co

# --- Admin ---
# Comma-separated emails allowed to open /admin/users.
ADMIN_EMAILS=you@example.com

# --- Optional (have sane defaults — normally leave as-is) ---
PACK_STORAGE_BUCKET=pack-pdfs
PACK_SIGNED_URL_TTL_SECONDS=3600
ALLOW_PUBLIC_PDF_FALLBACK=false
